{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "license-portal/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/licenses/(?<id>[^/]+)", "dest": "/api/licenses/[id].js?id=$id" },
    { "src": "/api/(?<file>[^/]+)", "dest": "/api/$file.js" },
    { "src": "/(.*)", "dest": "/license-portal/public/$1" }
  ]
}
